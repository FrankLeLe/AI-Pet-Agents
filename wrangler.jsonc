{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-pet-studio",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    // Keep Cloudflare's default per-version cache isolation so a deployment
    // cannot serve a previous release's ZIP against new SHA-256 metadata.
    "enabled": true
  },
  "no_bundle": true,
  "assets": {
    "directory": "./dist/client",
    // Existing files are served directly from Cloudflare's asset edge. The
    // Worker only runs for versioned download aliases that do not exist on disk.
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "aipetsagent.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}

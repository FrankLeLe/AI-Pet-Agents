{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-pet-studio",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "no_bundle": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "aipetsagent.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
